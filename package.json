{
	"name": "frontend-github",
	"private": true,
	"version": "2.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && vite build",
		"paraglide:generate": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"mock:oidc": "node samples/oidc-mock-server/server.mjs",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"postinstall": "[ \"$NODE_ENV\" = production ] && exit 0; paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"screenshots": "playwright test --config=playwright-screenshots.config.ts",
		"screenshots:ci": "PLAYWRIGHT_BASE_URL=http://localhost:3000 playwright test --config=playwright-screenshots.config.ts",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.3.1",
		"@inlang/paraglide-js": "^2.25.2",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.46.0",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@oslojs/jwt": "^0.3.0",
		"@pdfslick/core": "^4.0.2",
		"@playwright/test": "^1.63.0",
		"@storybook/addon-a11y": "^10.6.0",
		"@storybook/addon-docs": "^10.6.0",
		"@storybook/addon-svelte-csf": "^5.1.3",
		"@storybook/sveltekit": "^10.6.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/fhir": "^0.0.44",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^22.20.3",
		"@types/pg": "^8.23.1",
		"@unovis/svelte": "^1.7.0",
		"@unovis/ts": "^1.7.0",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"dayjs": "^1.11.23",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"formsnap": "^2.0.1",
		"husky": "^9.1.7",
		"leaflet": "^1.9.4",
		"lint-staged": "^17.5.1",
		"lodash-es": "^4.18.1",
		"oauth2-mock-server": "^9.2.0",
		"openid-client": "^6.8.8",
		"pg": "^8.23.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.9.7",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"runed": "^0.37.1",
		"storybook": "^10.6.0",
		"sveaflet": "^0.1.5",
		"svelte": "^5.57.0",
		"svelte-breadcrumbs": "^2.0.1",
		"svelte-check": "^4.7.6",
		"sveltekit-superforms": "^2.30.2",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"uuid": "^14.0.2",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.3.0",
		"vite-plugin-kit-routes": "^1.0.6",
		"vitest": "^5.0.1",
		"zod": "^4.6.5"
	},
	"dependencies": {
		"mode-watcher": "^1.1.0"
	},
	"volta": {
		"node": "22.23.2",
		"pnpm": "10.34.5"
	},
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"pnpm": {
		"patchedDependencies": {
			"svelte-breadcrumbs": "patches/svelte-breadcrumbs.patch"
		},
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,md,html,css}": "prettier --write"
	}
}
